# ============================================================
# Cenomi Mall Concierge — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
BACKEND_LOG_LEVEL=debug
BACKEND_DEBUG=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Mall Configuration ---
# Comma-separated list of mall IDs to load at startup.
# Add more malls by appending ,<mall_id> and restarting the backend.
BACKEND_MALL_IDS=al_nakheel_plaza_28,al_nakheel_plaza_13

# --- Vector Store / Retrieval ---
# VECTOR_STORE_TYPE=chroma
# CHROMA_PERSIST_DIR=./backend/data/vectorstore
# EMBEDDING_MODEL=text-embedding-3-small

# --- Observability ---
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cenomi-concierge
# ENABLE_TRACING=false

# --- Feedback ---
FEEDBACK_STORAGE=local
# FEEDBACK_DB_URL=

# --- Redis (session persistence) ---
# Leave empty to use the in-memory store (single-process dev, no Redis needed).
# Docker Compose sets this automatically via the 'redis' service name.
BACKEND_REDIS_URL=
BACKEND_REDIS_SESSION_TTL=1800

# --- LangGraph Checkpointer ---
# Snapshot-persists every graph turn for replay/debugging.
BACKEND_ENABLE_CHECKPOINTER=false

# --- Async Quality Evaluator ---
# LLM-as-judge scoring that fires after every turn (never blocks responses).
BACKEND_ENABLE_EVALUATOR=false
